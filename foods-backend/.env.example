HTTP_ADDR=:8080
# Formato: postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
DATABASE_MAX_CONNS=12
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# Fudia Concierge: configuración global, nunca por empresa/local.
FUDIA_CONCIERGE_API_KEY=

# Facturación electrónica: llave maestra (32 bytes en base64) que cifra las
# credenciales SOL y certificados de cada empresa; en GCP viene de Secret Manager.
FUDIA_EINVOICING_MASTER_KEY=
FUDIA_EINVOICING_KEY_VERSION=1
# Llaves anteriores para leer lo ya cifrado tras rotar: "1:base64,2:base64".
FUDIA_EINVOICING_PREVIOUS_KEYS=
# Clave de los endpoints internos que llaman Cloud Tasks y Cloud Scheduler.
FUDIA_EINVOICING_WORKER_KEY=

# GCP: referencias/configuración, sin claves de cuenta de servicio.
# Mantener local en entornos AWS que usan el adaptador existente.
PRODUCT_IMAGE_STORAGE=local
PRODUCT_IMAGES_BUCKET=
PRODUCT_IMAGES_SIGNER=

FUDIA_CONCIERGE_URL=http://localhost:8010
