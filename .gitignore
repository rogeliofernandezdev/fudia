.npm-cache/
.cache/
.gocache/
.gomodcache/
.gopath/
**/node_modules/
**/.next/
**/.next-dev/
**/.env
**/.env.local
**/.env.*.local
**/*.exe
**/*.log

foods-admin-web/__*.png
foods-admin-web/__*.cjs

# Salidas locales de pruebas y capturas (logs, PNG, pdfjs descargado): nunca se versionan.
tmp/
# Carpeta creada por un `--out-dir` mal pasado a un script de capturas.
**/--out-dir/

# Generated from the pinned Mozilla distribution by pdfjs:prepare.
foods-admin-web/public/pdfjs/

# Temporary credentials created by google-github-actions/auth (OIDC).
gha-creds-*.json

# Salidas de compilación de Android (Gradle); el APK publicado vive en la raíz.
fudia-pay/.gradle/
fudia-pay/build/
fudia-pay/app/build/

# Documentos de Word (entregables locales) y sus temporales «~$…»: nunca se versionan.
*.docx
~$*
