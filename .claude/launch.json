{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "foods-admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "foods-admin-web",
        "run",
        "dev"
      ],
      "port": 5175
    },
    {
      "name": "fudia-concierge",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd fudia-concierge && .venv\\Scripts\\python.exe -m uvicorn src.main:app --host 127.0.0.1 --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "sales-preview",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd foods-admin-web && node tests/helpers/sales-page-preview.mjs"
      ],
      "port": 5196
    },
    {
      "name": "pay-notifications-preview",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd foods-admin-web && node tests/helpers/pay-notifications-preview.mjs"
      ],
      "port": 5198
    }
  ]
}