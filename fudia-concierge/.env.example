ENV=development
LOG_LEVEL=INFO

FUDIA_API_URL=http://localhost:8080
FUDIA_CONCIERGE_API_KEY=replace-me

REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=43200

QUEUE_STREAM=fudia:concierge:inbound
QUEUE_GROUP=fudia-concierge
QUEUE_CONSUMER=
# Set false for stateless HTTP ingress; use a separate always-on queue worker.
WORKER_ENABLED=true
QUEUE_MAX_ATTEMPTS=5
QUEUE_VISIBILITY_TIMEOUT_MS=30000
QUEUE_WORKER_CONCURRENCY=8
QUEUE_SHUTDOWN_GRACE_SECONDS=8
QUEUE_TURN_WAIT_SECONDS=8
QUEUE_ORDER_MAX_WAIT_SECONDS=120
QUEUE_ORDER_TTL_SECONDS=604800
QUEUE_RETENTION_SECONDS=86400
QUEUE_DEAD_LETTER_RETENTION_SECONDS=1209600
QUEUE_MAINTENANCE_INTERVAL_SECONDS=300
PROCESSING_RECORD_TTL_SECONDS=259200
PROCESSING_PENDING_RECORD_TTL_SECONDS=1209600
OUTBOUND_RECONCILE_SECONDS=30
# 1: resend once if Meta never confirms (text may repeat). 0: never resend.
OUTBOUND_MAX_RESENDS=1

CONVERSATION_LOCK_TTL_SECONDS=30
CONVERSATION_LOCK_WAIT_SECONDS=8
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGE_CHARS=2000
WEBHOOK_MAX_PAYLOAD_BYTES=262144

# Model provider: vertex (Gemini, default) or openai.
LLM_PROVIDER=vertex
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_TOOL_ROUNDS=8

# Vertex AI uses Application Default Credentials (no API key).
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=global
# Lite: router, menu, service. Flash: orders and escalation from Lite.
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.5-flash

# Only with LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_LITE=

WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_ID=replace-me
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_GRAPH_VERSION=replace-with-supported-version
