# Solo servidor/BFF. Nunca usar NEXT_PUBLIC_ para secretos.
FOODS_API_URL=http://localhost:8080

# Servicio interno de Concierge; no contiene número de WhatsApp.
FUDIA_CONCIERGE_URL=http://localhost:8010

# Proveedor cartográfico activo. Actualmente foods-admin-web implementa Mapbox.
NEXT_PUBLIC_MAP_PROVIDER=mapbox

# Token público para renderizar el mapa en el navegador.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Token usado exclusivamente por las rutas BFF de geocodificación.
MAPBOX_ACCESS_TOKEN=
